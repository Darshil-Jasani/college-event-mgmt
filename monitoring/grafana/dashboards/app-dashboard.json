{
  "title": "College Event Mgmt - Overview",
  "uid": "college-events",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP requests / sec", "gridPos": {"h":8,"w":12,"x":0,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (status)", "legendFormat": "{{status}}"}] },
    { "id": 2, "type": "timeseries", "title": "Avg response time (s)", "gridPos": {"h":8,"w":12,"x":12,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_sum[1m])) / sum(rate(http_server_requests_seconds_count[1m]))"}] },
    { "id": 3, "type": "timeseries", "title": "JVM heap used (bytes)", "gridPos": {"h":8,"w":12,"x":0,"y":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"}] },
    { "id": 4, "type": "logs", "title": "Application logs", "gridPos": {"h":8,"w":12,"x":12,"y":8},
      "datasource": {"type":"loki","uid":"loki"},
      "targets": [{"expr": "{container=~\".*app.*\"}"}] }
  ]
}
